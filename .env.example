# =====================================================================
# Jaqueline Sias Despachante — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# =====================================================================

# Ambiente: development | production
APP_ENV=production

# Chave secreta (obrigatória em produção). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# URL pública do site, sem barra no final (canonical, sitemap, Open Graph)
SITE_URL=https://www.seudominio.com.br
# Domínio usado pelo Caddy/HTTPS (docker-compose.prod.yml), sem https://
DOMAIN=www.seudominio.com.br

# ---------------------------------------------------------------------
# Dados do negócio — preencha SOMENTE com informações confirmadas.
# Campos vazios simplesmente não aparecem no site.
# ---------------------------------------------------------------------
# WhatsApp com DDI + DDD + número, só dígitos (ex.: 5521999999999).
# Se ficar vazio, os botões de WhatsApp são substituídos pelo formulário.
WHATSAPP_NUMBER=5521972602420
WHATSAPP_DEFAULT_MESSAGE=Olá, Jaqueline! Acessei seu site e gostaria de informações sobre serviços de despachante.
CONTACT_EMAIL=jaquelinesias@hotmail.com
INSTAGRAM_URL=https://www.instagram.com/jaquelinesiasdespachante/
INSTAGRAM_HANDLE=@jaquelinesiasdespachante
BUSINESS_CITY=Niterói
BUSINESS_STATE=RJ
# Endereço comercial (opcional) — só preencha se for público
BUSINESS_ADDRESS=
BUSINESS_POSTAL_CODE=
BUSINESS_HOURS=
# URL de incorporação do Google Maps (https://www.google.com/maps/embed?pb=...)
MAPS_EMBED_URL=
# Link para as avaliações no Google (perfil da empresa)
GOOGLE_REVIEWS_URL=
# Código de verificação do Google Search Console (opcional)
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------
# Formulário de contato
# ---------------------------------------------------------------------
# Grava as mensagens em instance/contatos.jsonl (volume Docker "contatos")
CONTACT_STORE_ENABLED=true
# Envio por e-mail (opcional). Ex. Outlook/Hotmail: smtp-mail.outlook.com, 587, TLS
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
# Quem recebe as mensagens (padrão: CONTACT_EMAIL)
MAIL_RECIPIENT=

# ---------------------------------------------------------------------
# Segurança e infraestrutura
# ---------------------------------------------------------------------
# true em produção com HTTPS. Use false para testar via http em rede local.
SESSION_COOKIE_SECURE=false
# true quando estiver atrás de proxy reverso (Caddy, Nginx, Render, etc.)
TRUST_PROXY=false
# Limites de requisição. Para várias instâncias use redis://host:6379
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per hour
RATELIMIT_CONTACT=5 per minute;20 per day
GUNICORN_WORKERS=2
LOG_LEVEL=INFO
# Porta exposta no host (docker-compose.yml)
HOST_PORT=8000
